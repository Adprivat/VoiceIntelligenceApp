# API Keys werden in der App über die Einstellungen konfiguriert (Settings > API-Schlüssel).
# Diese Datei dient nur als Referenz für die unterstützten Anbieter.

# OpenAI (für GPT-4o-mini und Whisper Transkription)
# OPENAI_API_KEY=sk-...

# Anthropic (für Claude 3.5 Sonnet)
# ANTHROPIC_API_KEY=sk-ant-...

# Google AI (für Gemini 2.0 Flash)
# GOOGLE_AI_API_KEY=AI...

# Groq (für Llama 3.3 70B und Whisper Turbo Transkription)
# GROQ_API_KEY=gsk_...
